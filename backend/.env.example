# 后端环境变量示例
# 复制为 .env 后按需修改

# 数据库：SQLite（默认）或 PostgreSQL
# DATABASE_URL=sqlite:///./lottery.db
# DATABASE_URL=postgresql+psycopg://user:password@db:5432/lottery

# 调试模式
DEBUG=true

# 管理后台口令：保护活动管理、名单导入、奖项配置、执行抽奖、领奖核销、
# 统计导出与二维码生成等接口，以及大屏的 WebSocket 实时通道。
# 留空则启动时自动生成一个随机口令并打印到控制台（仅存于内存，重启后失效）。
# 长期运行的服务建议在此固定一个强口令。
ADMIN_TOKEN=

# 领奖码签名密钥（正式环境建议显式配置随机值）
CLAIM_SECRET=

# 签到二维码指向的前端地址
CHECKIN_BASE_URL=http://172.31.20.69:5173/checkin
